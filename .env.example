# Mysql
# MYSQL_USER 不能填 root：官方 mysql 镜像会直接拒绝启动，
# root 的密码统一由 MYSQL_ROOT_PASSWORD 控制。
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=interview
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=interview
MYSQL_ROOT_PASSWORD=change-me

# redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=change-me
# 内存上限。满后淘汰最久未访问的键。本地开发 256mb 足够。
REDIS_MAXMEMORY=256mb

# timezone
# 同一个值会同时作用于容器时区和 MySQL 的 --default-time-zone，不要只改一处
TZ=Asia/Shanghai

# email
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=1234567890@qq.com
SMTP_PASSWORD=your_password
SMTP_FROM=1234567890@qq.com

# jwt
JWT_SECRET=eRh0G_NYQ8vdVxAws4-CxsA0nPQgI5G-
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# resume
RESUME_UPLOAD_DIR=./uploads

# llm
llm_api_key=str
llm_model_heavy=gpt-4o-mini
llm_model_light=deepseek-flash
llm_base_url=https://api.openai.com/v1

