# Mysql
# MYSQL_USER 不能填 root：官方 mysql 镜像会直接拒绝启动，
# root 的密码统一由 MYSQL_ROOT_PASSWORD 控制。
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_USER=trip_plan
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=trip_plan
MYSQL_ROOT_PASSWORD=change-me

# redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=change-me
# 内存上限。满后淘汰最久未访问的键。本地开发 256mb 足够。
REDIS_MAXMEMORY=256mb

# timezone
# 同一个值会同时作用于容器时区和 MySQL 的 --default-time-zone，不要只改一处
TZ=Asia/Shanghai
